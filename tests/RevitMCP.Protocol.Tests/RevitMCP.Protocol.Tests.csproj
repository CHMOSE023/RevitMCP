<Project Sdk="Microsoft.NET.Sdk">
  <!-- 不依赖 Revit，可在任意 Windows 机器 / CI 上直接 dotnet test -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputPath>$(MSBuildThisFileDirectory)bin\</OutputPath>
    <RootNamespace>RevitMCP.Protocol.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RevitMCP.Protocol\RevitMCP.Protocol.csproj" />
  </ItemGroup>
</Project>
