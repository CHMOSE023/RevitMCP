<Project Sdk="Microsoft.NET.Sdk">
  <!-- 调度队列的超时/放弃/竞态语义不依赖 Revit，因此可以在 CI 上完整验证。 -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputPath>$(MSBuildThisFileDirectory)bin\</OutputPath>
    <RootNamespace>RevitMCP.Tooling.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RevitMCP.Tooling\RevitMCP.Tooling.csproj" />
  </ItemGroup>
</Project>
